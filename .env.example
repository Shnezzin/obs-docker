# OBS Docker Environment Configuration
# Copy this file to .env and customize the values

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=production
FLASK_DEBUG=false

# Security Configuration
CSRF_ENABLED=true
RATE_LIMIT=200 per day;50 per hour
SESSION_TIMEOUT=3600

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_API_VERSION=auto

# OBS Container Defaults
DEFAULT_USER=developer
DEFAULT_PASSWD=SecurePassword123!
DESKTOP_ENV=lxde
ENABLE_GPU=false
LOCALE=en_US.UTF-8
TIMEZONE=UTC

# Web Manager Configuration
WEB_PORT=8080
WEB_HOST=0.0.0.0
ENABLE_SSL=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Monitoring Configuration
ENABLE_MONITORING=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/opt/obs-backups

# Cloud Integration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/obs-docker/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Performance Configuration
MAX_INSTANCES=10
INSTANCE_MEMORY_LIMIT=2g
INSTANCE_CPU_LIMIT=2.0

# Network Configuration
NETWORK_NAME=obs-network
SUBNET=172.20.0.0/16

# Plugin Configuration
PLUGIN_REPOSITORY=https://github.com/obsproject/obs-studio/releases
AUTO_UPDATE_PLUGINS=false

# Development Configuration (only for development)
DEV_MODE=false
DEV_RELOAD=false
DEV_PROFILER=false