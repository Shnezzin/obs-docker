# OBS Studio Docker Container Configuration
# Copy this file to .env and customize the values

# User Configuration
OBS_USER=developer
OBS_PASSWD=SecurePassword123!
OBS_GROUP=developer

# Build Configuration
OBS_VERSION=31.1.1
UBUNTU_VERSION=24.04

# Localization (default: English US)
LOCALE=en_US.UTF-8
TIMEZONE=UTC

# Alternative locale examples:
# LOCALE=de_DE.UTF-8  # German
# LOCALE=fr_FR.UTF-8  # French
# LOCALE=es_ES.UTF-8  # Spanish
# LOCALE=ja_JP.UTF-8  # Japanese

# Alternative timezone examples:
# TIMEZONE=America/New_York
# TIMEZONE=Europe/London
# TIMEZONE=Asia/Tokyo
# TIMEZONE=Australia/Sydney

# Security: Change these in production!
# Use strong passwords (minimum 12 characters with mixed case, numbers, symbols)
# Consider certificate-based authentication for RDP
# Regularly update the container and base images

# Flask Configuration
FLASK_APP=web/app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=generate-a-secure-secret-key-here

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Generate a secure password hash with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Security
CSRF_ENABLED=True
RATE_LIMIT=200 per day;50 per hour
ALLOWED_ORIGINS=*

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TIMEOUT=60

# OBS Configuration
OBS_VERSION=31.1.1
UBUNTU_VERSION=24.04
LOCALE=en_US.UTF-8
TIMEZONE=UTC
DESKTOP_ENV=lxde
ENABLE_GPU=false

# Paths
SCRIPTS_DIR=/scripts
CONFIG_DIR=/opt/obs-config
INSTANCES_DIR=/opt/obs-instances
UPLOAD_FOLDER=/tmp/uploads

# Backup Configuration
BACKUP_DIR=/opt/obs-backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/obs-docker/app.log

# Email Notifications (optional)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=no-reply@example.com
