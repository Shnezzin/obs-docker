FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including CLI tools needed by scripts
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    bc \
    netstat-nat \
    procps \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install setuptools first
RUN pip install --upgrade pip setuptools>=65.0.0

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app.py .
COPY debug_docker.py .
COPY test_docker_simple.py .
COPY templates/ templates/

# Create necessary directories
RUN mkdir -p /opt/obs-config /opt/obs-instances /opt/obs-backups

# Create non-root user and add to docker group for Docker socket access
# Note: Docker group GID may vary between systems, so we handle this flexibly
RUN groupadd -g 999 docker 2>/dev/null || groupmod -g 999 docker 2>/dev/null || true && \
    useradd -m -u 1000 webuser && \
    usermod -aG docker webuser && \
    # Ensure webuser can access docker socket regardless of GID
    usermod -aG 0 webuser && \
    chown -R webuser:webuser /app /opt/obs-config /opt/obs-instances /opt/obs-backups && \
    # Debug: Show user and group info
    echo "User info:" && id webuser && \
    echo "Docker group info:" && getent group docker || echo "Docker group not found"

# Switch to non-root user
USER webuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/api/system/stats || exit 1

# Start the application
CMD ["gunicorn", "--worker-class", "eventlet", "-w", "1", "--bind", "0.0.0.0:8080", "app:app"]
